# Copy to /srv/tiny-brain/compose/.env and review every value.
# The repository-level .env is not used as a secret store.
TINY_BRAIN_VAULT_HOST=/srv/tiny-brain/vault
TINY_BRAIN_DATA_HOST=/srv/tiny-brain/data
TINY_BRAIN_MODELS_HOST=/srv/tiny-brain/models
TINY_BRAIN_CADDY_DATA_HOST=/srv/tiny-brain/compose/caddy-data
TINY_BRAIN_CADDY_CONFIG_HOST=/srv/tiny-brain/compose/caddy-config
TINY_BRAIN_SYNCTHING_CONFIG_HOST=/srv/tiny-brain/compose/syncthing
TINY_BRAIN_PUID=1000
TINY_BRAIN_PGID=1000
TINY_BRAIN_CHAT_MODEL=gemma-4-E2B-it-q4_k_m.gguf
TINY_BRAIN_CONTEXT_TOKENS=8192
TINY_BRAIN_MAX_OUTPUT_TOKENS=4096
TINY_BRAIN_LLAMA_TIMEOUT=300
TINY_BRAIN_MAX_TOOL_LOOPS=2
TINY_BRAIN_EMBEDDING_RUNTIME=fastembed
TINY_BRAIN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLAMA_THREADS=4
LLAMA_THREADS_BATCH=4
LLAMA_N_GPU_LAYERS=99
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-vulkan
LLAMA_LOOKUP_NGRAM_MIN=2
TINY_BRAIN_LAN_HOST=tiny-brain.home.arpa
TINY_BRAIN_AUTO_INBOX_ENABLED=true
TINY_BRAIN_AUTO_INBOX_CONFIDENCE=0.9
TINY_BRAIN_RUNTIME_OFFLINE=true
