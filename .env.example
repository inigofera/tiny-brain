TINY_BRAIN_CADDY_DATA_HOST=/srv/tiny-brain/compose/caddy-data
TINY_BRAIN_CADDY_CONFIG_HOST=/srv/tiny-brain/compose/caddy-config
TINY_BRAIN_SYNCTHING_CONFIG_HOST=/srv/tiny-brain/compose/syncthing
TINY_BRAIN_PUID=1000
TINY_BRAIN_PGID=1000
TINY_BRAIN_CHAT_MODEL=Spark-X2.5-1.7B-Q6_K.gguf
TINY_BRAIN_CONTEXT_TOKENS=16384
TINY_BRAIN_MAX_OUTPUT_TOKENS=4096
TINY_BRAIN_LLAMA_TIMEOUT=300
TINY_BRAIN_MAX_TOOL_LOOPS=2
